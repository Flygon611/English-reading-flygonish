, "" ] }, { "id": "g21", "text": "The thief was caught by the police last night.", "pos": [ "det", "noun", "aux", "verb", "prep", "det", "noun", "adj", "noun" ], "level": "simple", "roles": [ "subj", "subj", "aux", "pred", "", "", "", "", "" ] }, { "id": "g22", "text": "The book that I bought yesterday is very useful.", "pos": [ "det", "noun", "pron", "pron", "verb", "adv", "verb", "adv", "adj" ], "level": "complex", "roles": [ "subj", "subj", "", "", "", "", "pred", "comp", "comp" ] }, { "id": "g23", "text": "The man who lives next door is a doctor.", "pos": [ "det", "noun", "pron", "verb", "adj", "noun", "verb", "det", "noun" ], "level": "complex", "roles": [ "subj", "subj", "", "", "", "", "pred", "comp", "comp" ] }, { "id": "g24", "text": "The house which stands on the hill is old.", "pos": [ "det", "noun", "pron", "verb", "prep", "det", "noun", "verb", "adj" ], "level": "complex", "roles": [ "subj", "subj", "", "", "", "", "", "pred", "comp" ] }, { "id": "g25", "text": "The woman whose son studies abroad works at the hospital.", "pos": [ "det", "noun", "det", "noun", "verb", "adv", "verb", "prep", "det", "noun" ], "level": "complex", "roles": [ "subj", "subj", "", "", "", "", "pred", "", "", "" ] }, { "id": "g26", "text": "This is the place where we first met.", "pos": [ "pron", "verb", "det", "noun", "adv", "pron", "adv", "verb" ], "level": "complex", "roles": [ "subj", "pred", "comp", "comp", "", "", "", "" ] }, { "id": "g27", "text": "I still remember the day when we graduated.", "pos": [ "pron", "adv", "verb", "det", "noun", "adv", "pron", "verb" ], "level": "complex", "roles": [ "subj", "", "pred", "obj", "obj", "", "", "" ] }, { "id": "g28", "text": "The report that the committee released surprised everyone.", "pos": [ "det", "noun", "pron", "det", "noun", "verb", "verb", "pron" ], "level": "complex", "roles": [ "subj", "subj", "", "", "", "", "pred", "obj" ] }, { "id": "g29", "text": "The people we met at the party were friendly.", "pos": [ "det", "noun", "pron", "verb", "prep", "det", "noun", "verb", "adj" ], "level": "complex", "roles": [ "subj", "subj", "", "", "", "", "", "pred", "comp" ] }, { "id": "g30", "text": "Although it was raining, we went out.", "pos": [ "conj", "pron", "aux", "verb", "pron", "verb", "adv" ], "level": "complex", "roles": [ "", "", "", "", "subj", "pred", "" ] }, { "id": "g31", "text": "Because he was tired, he went to bed early.", "pos": [ "conj", "pron", "verb", "adj", "pron", "verb", "prep", "noun", "adv" ], "level": "complex", "roles": [ "", "", "", "", "subj", "pred", "", "", "" ] }, { "id": "g32", "text": "When the bell rang, the students left the classroom.", "pos": [ "adv", "det", "noun", "verb", "det", "noun", "verb", "det", "noun" ], "level": "complex", "roles": [ "", "", "", "", "subj", "subj", "pred", "obj", "obj" ] }, { "id": "g33", "text": "If you study hard, you will pass the exam.", "pos": [ "conj", "pron", "verb", "adv", "pron", "modal", "verb", "det", "noun" ], "level": "complex", "roles": [ "", "", "", "", "subj", "aux", "pred", "obj", "obj" ] }, { "id": "g34", "text": "He stayed at home while his friends were traveling.", "pos": [ "pron", "verb", "prep", "noun", "conj", "det", "noun", "aux", "verb" ], "level": "complex", "roles": [ "subj", "pred", "", "", "", "", "", "", "" ] }, { "id": "g35", "text": "She spoke slowly so that everyone could understand her.", "pos": [ "pron", "verb", "adv", "conj", "conj", "pron", "modal", "verb", "pron" ], "level": "complex", "roles": [ "subj", "pred", "", "", "", "", "", "", "" ] }, { "id": "g36", "text": "As soon as the sun rose, the birds began to sing.", "pos": [ "conj", "adv", "conj", "det", "noun", "verb", "det", "noun", "verb", "part", "verb" ], "level": "complex", "roles": [ "", "", "", "", "", "", "subj", "subj", "pred", "", "" ] }, { "id": "g37", "text": "Even though the task was difficult, they finished it on time.", "pos": [ "adv", "conj", "det", "noun", "verb", "adj", "pron", "verb", "pron", "prep", "noun" ], "level": "complex", "roles": [ "", "", "", "", "", "", "subj", "pred", "obj", "", "" ] }, { "id": "g38", "text": "I think that he is right.", "pos": [ "pron", "verb", "conj", "pron", "verb", "adj" ], "level": "complex", "roles": [ "subj", "pred", "", "", "", "" ] }, { "id": "g39", "text": "What she said surprised everyone.", "pos": [ "pron", "pron", "verb", "verb", "pron" ], "level": "complex", "roles": [ "", "", "", "pred", "obj" ] }, { "id": "g40", "text": "Whether he will come remains uncertain.", "pos": [ "conj", "pron", "modal", "verb", "verb", "adj" ], "level": "complex", "roles": [ "", "", "", "", "pred", "comp" ] }, { "id": "g41", "text": "The fact that she apologized changed nothing.", "pos": [ "det", "noun", "conj", "pron", "verb", "verb", "pron" ], "level": "complex", "roles": [ "subj", "subj", "", "", "", "pred", "obj" ] }, { "id": "g42", "text": "He asked me if I had finished the report.", "pos": [ "pron", "verb", "pron", "conj", "pron", "aux", "verb", "det", "noun" ], "level": "complex", "roles": [ "subj", "pred", "obj", "", "", "", "", "", "" ] }, { "id": "g43", "text": "That the plan failed was obvious.", "pos": [ "conj", "det", "noun", "verb", "verb", "adj" ], "level": "complex", "roles": [ "", "", "", "", "pred", "comp" ] }, { "id": "g44", "text": "I do not know where he lives.", "pos": [ "pron", "aux", "adv", "verb", "adv", "pron", "verb" ], "level": "complex", "roles": [ "subj", "aux", "", "pred", "", "", "" ] }, { "id": "g45", "text": "To master a language, you need patience.", "pos": [ "part", "verb", "det", "noun", "pron", "verb", "noun" ], "level": "complex", "roles": [ "", "", "", "", "subj", "pred", "obj" ] }, { "id": "g46", "text": "Reading novels helps improve vocabulary.", "pos": [ "verb", "noun", "verb", "verb", "noun" ], "level": "complex", "roles": [ "subj", "subj", "pred", "", "" ] }, { "id": "g47", "text": "The students, excited by the news, rushed out of the classroom.", "pos": [ "det", "noun", "verb", "prep", "det", "noun", "verb", "adv", "prep", "det", "noun" ], "level": "complex", "roles": [ "subj", "subj", "", "", "", "", "pred", "", "", "", "" ] }, { "id": "g48", "text": "She sat by the window, watching the rain fall.", "pos": [ "pron", "verb", "prep", "det", "noun", "verb", "det", "noun", "verb" ], "level": "complex", "roles": [ "subj", "pred", "", "", "", "", "", "", "" ] }, { "id": "g49", "text": "He went to the library to borrow some books.", "pos": [ "pron", "verb", "prep", "det", "noun", "part", "verb", "det", "noun" ], "level": "complex", "roles": [ "subj", "pred", "", "", "", "", "", "", "" ] }, { "id": "g50", "text": "Determined to win, the team trained every morning.", "pos": [ "adj", "part", "verb", "det", "noun", "verb", "det", "noun" ], "level": "complex", "roles": [ "", "", "", "subj", "subj", "pred", "", "" ] }, { "id": "g51", "text": "Having finished his work, he left the office.", "pos": [ "verb", "verb", "det", "noun", "pron", "verb", "det", "noun" ], "level": "complex", "roles": [ "", "", "", "", "subj", "pred", "obj", "obj" ] }, { "id": "g52", "text": "He wrote the letter and she mailed it.", "pos": [ "pron", "verb", "det", "noun", "conj", "pron", "verb", "pron" ], "level": "complex", "roles": [ "subj", "pred", "obj", "obj", "", "subj", "pred", "obj" ] }, { "id": "g53", "text": "The sun was shining, but the wind was cold.", "pos": [ "det", "noun", "aux", "verb", "conj", "det", "noun", "verb", "adj" ], "level": "complex", "roles": [ "subj", "subj", "aux", "pred", "", "subj", "subj", "pred", "comp" ] }, { "id": "g54", "text": "She wanted to stay, yet she had to leave.", "pos": [ "pron", "verb", "part", "verb", "conj", "pron", "verb", "part", "verb" ], "level": "complex", "roles": [ "subj", "pred", "", "", "", "subj", "pred", "", "" ] }, { "id": "g55", "text": "The meeting ended early, and everyone went home.", "pos": [ "det", "noun", "verb", "adv", "conj", "pron", "verb", "adv" ], "level": "complex", "roles": [ "subj", "subj", "pred", "", "", "subj", "pred", "" ] }, { "id": "g56", "text": "Either you apologize or I will leave.", "pos": [ "conj", "pron", "verb", "conj", "pron", "modal", "verb" ], "level": "complex", "roles": [ "", "subj", "pred", "", "subj", "aux", "pred" ] }, { "id": "g57", "text": "There are many reasons for this decision.", "pos": [ "pron", "verb", "det", "noun", "prep", "det", "noun" ], "level": "simple", "roles": [ "", "pred", "subj", "subj", "", "", "" ] }, { "id": "g58", "text": "There is a small cafe near the station.", "pos": [ "pron", "verb", "det", "adj", "noun", "prep", "det", "noun" ], "level": "simple", "roles": [ "", "pred", "subj", "subj", "subj", "", "", "" ] }, { "id": "g59", "text": "It is important to practice every day.", "pos": [ "pron", "verb", "adj", "part", "verb", "det", "noun" ], "level": "simple", "roles": [ "", "pred", "comp", "", "", "", "" ] }, { "id": "g60", "text": "It seems that they have already left.", "pos": [ "pron", "verb", "conj", "pron", "aux", "adv", "verb" ], "level": "complex", "roles": [ "", "pred", "", "", "", "", "" ] }, { "id": "g61", "text": "Do you know the answer?", "pos": [ "aux", "pron", "verb", "det", "noun" ], "level": "simple", "roles": [ "", "subj", "pred", "obj", "obj" ] }, { "id": "g62", "text": "Why did the company close the factory?", "pos": [ "adv", "aux", "det", "noun", "verb", "det", "noun" ], "level": "simple", "roles": [ "", "", "subj", "subj", "pred", "obj", "obj" ] }, { "id": "g63", "text": "Have you ever visited Paris?", "pos": [ "aux", "pron", "adv", "verb", "propn" ], "level": "simple", "roles": [ "", "subj", "", "pred", "obj" ] }, { "id": "g64", "text": "Could you explain this rule again?", "pos": [ "modal", "pron", "verb", "det", "noun", "adv" ], "level": "simple", "roles": [ "", "subj", "pred", "obj", "obj", "" ] }, { "id": "g65", "text": "Close the door, please.", "pos": [ "verb", "det", "noun", "interj" ], "level": "simple", "roles": [ "pred", "obj", "obj", "" ] }, { "id": "g66", "text": "Do not forget your homework.", "pos": [ "aux", "adv", "verb", "det", "noun" ], "level": "simple", "roles": [ "aux", "", "pred", "obj", "obj" ] }, { "id": "g67", "text": "Let us start the meeting now.", "pos": [ "verb", "pron", "verb", "det", "noun", "adv" ], "level": "simple", "roles": [ "pred", "obj", "", "", "", "" ] }, { "id": "g68", "text": "She is taller than her brother.", "pos": [ "pron", "verb", "adj", "conj", "det", "noun" ], "level": "simple", "roles": [ "subj", "pred", "comp", "", "", "" ] }, { "id": "g69", "text": "This test is more difficult than the previous one.", "pos": [ "det", "noun", "verb", "adv", "adj", "conj", "det", "adj", "pron" ], "level": "simple", "roles": [ "subj", "subj", "pred", "comp", "comp", "", "", "", "" ] }, { "id": "g70", "text": "Not only did he finish the work, but he also helped others.", "pos": [ "adv", "adv", "aux", "pron", "verb", "det", "noun", "conj", "pron", "adv", "verb", "pron" ], "level": "complex", "roles": [ "", "", "", "subj", "pred", "obj", "obj", "", "subj", "", "pred", "obj" ] }, { "id": "g71", "text": "The committee, which had been deliberating for nearly six hours, finally reached a conclusion that satisfied neither the union representatives nor the management.", "pos": [ "det", "noun", "pron", "aux", "aux", "verb", "prep", "adv", "num", "noun", "adv", "verb", "det", "noun", "pron", "verb", "det", "det", "noun", "noun", "conj", "det", "noun" ], "level": "long", "roles": [ "subj", "subj", "", "", "", "", "", "", "", "", "", "pred", "obj", "obj", "", "", "", "", "", "", "", "", "" ] }, { "id": "g72", "text": "Scientists have discovered that the deep-sea creature, previously thought to be extinct, is capable of regenerating damaged tissue.", "pos": [ "noun", "aux", "verb", "conj", "det", "adj", "noun", "adv", "verb", "part", "verb", "adj", "verb", "adj", "prep", "verb", "adj", "noun" ], "level": "long", "roles": [ "subj", "aux", "pred", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "" ] }, { "id": "g73", "text": "It was a bright cold day in April, and the clocks were striking thirteen.", "pos": [ "pron", "verb", "det", "adj", "adj", "noun", "prep", "propn", "conj", "det", "noun", "aux", "verb", "num" ], "level": "long", "roles": [ "subj", "pred", "comp", "comp", "comp", "comp", "", "", "", "subj", "subj", "aux", "pred", "obj" ] }, { "id": "g74", "text": "Never have I seen such a beautiful sunset.", "pos": [ "adv", "aux", "pron", "verb", "det", "det", "adj", "noun" ], "level": "complex", "roles": [ "", "aux", "subj", "pred", "obj", "obj", "obj", "obj" ] }, { "id": "g75", "text": "Only after the meeting did he realize the mistake.", "pos": [ "adv", "prep", "det", "noun", "aux", "pron", "verb", "det", "noun" ], "level": "complex", "roles": [ "", "", "", "", "aux", "subj", "pred", "obj", "obj" ] }, { "id": "g76", "text": "There have been several changes since last year.", "pos": [ "pron", "aux", "aux", "det", "noun", "prep", "adj", "noun" ], "level": "complex", "roles": [ "", "aux", "pred", "subj", "subj", "", "", "" ] }, { "id": "g77", "text": "The book, which was published in that year, has been translated into many languages.", "pos": [ "det", "noun", "pron", "aux", "verb", "prep", "det", "noun", "aux", "aux", "verb", "prep", "adj", "noun" ], "level": "long", "roles": [ "subj", "subj", "", "", "", "", "", "", "aux", "aux", "pred", "", "", "" ] }, { "id": "g78", "text": "He suggested that we should leave early.", "pos": [ "pron", "verb", "conj", "pron", "modal", "verb", "adv" ], "level": "complex", "roles": [ "subj", "pred", "", "", "", "", "" ] }, { "id": "g79", "text": "The news made everyone happy.", "pos": [ "det", "noun", "verb", "pron", "adj" ], "level": "simple", "roles": [ "subj", "subj", "pred", "obj", "comp" ] }, { "id": "g80", "text": "She asked him to help her.", "pos": [ "pron", "verb", "pron", "part", "verb", "pron" ], "level": "complex", "roles": [ "subj", "pred", "obj", "", "", "" ] }, { "id": "g81", "level": "complex", "text": "I do not know whether he will come tomorrow.", "pos": [ "pron", "aux", "adv", "verb", "conj", "pron", "modal", "verb", "adv" ], "roles": [ "subj", "", "", "pred", "", "", "aux", "", "" ] }, { "id": "g82", "level": "complex", "text": "The man who lives next door is very friendly.", "pos": [ "det", "noun", "pron", "verb", "adj", "noun", "verb", "adv", "adj" ], "roles": [ "subj", "subj", "", "", "", "", "pred", "comp", "comp" ] }, { "id": "g83", "level": "simple", "text": "The book was written by a young scientist.", "pos": [ "det", "noun", "aux", "verb", "prep", "det", "adj", "noun" ], "roles": [ "subj", "subj", "aux", "pred", "", "", "", "" ] }, { "id": "g84", "level": "complex", "text": "Having finished her homework, she went to bed.", "pos": [ "verb", "verb", "det", "noun", "pron", "verb", "prep", "noun" ], "roles": [ "", "", "", "", "subj", "pred", "", "" ] }, { "id": "g85", "level": "simple", "text": "It is important to exercise every day.", "pos": [ "pron", "verb", "adj", "part", "verb", "det", "noun" ], "roles": [ "", "pred", "comp", "", "", "", "" ] }, { "id": "g86", "level": "simple", "text": "There is a cat under the table.", "pos": [ "pron", "verb", "det", "noun", "prep", "det", "noun" ], "roles": [ "", "pred", "subj", "subj", "", "", "" ] }, { "id": "g87", "level": "complex", "source": "reader.sample", "text": "When I first began to read seriously, I treated every book as a test.", "pos": [ "adv", "pron", "adv", "verb", "part", "verb", "adv", "pron", "verb", "det", "noun", "prep", "det", "noun" ], "roles": [ "", "", "", "", "", "", "", "subj", "pred", "obj", "obj", "", "", "" ] }, { "id": "g88", "level": "complex", "source": "reader.sample", "text": "I underlined difficult words, copied their definitions into a notebook, and promised myself that I would review them later.", "pos": [ "pron", "verb", "adj", "noun", "verb", "det", "noun", "prep", "det", "noun", "conj", "verb", "pron", "conj", "pron", "modal", "verb", "pron", "adv" ], "roles": [ "subj", "pred", "obj", "obj", "pred", "obj", "obj", "", "", "", "", "pred", "obj", "", "", "", "", "", "" ] }, { "id": "g89", "level": "simple", "source": "reader.sample", "text": "Usually I did not.", "pos": [ "adv", "pron", "verb", "adv" ], "roles": [ "", "subj", "pred", "" ] }, { "id": "g90", "level": "complex", "source": "reader.sample", "text": "It tells you which meaning is being used, what tone the writer intends, and why this word rather than a simpler one.", "pos": [ "pron", "verb", "pron", "det", "noun", "aux", "aux", "verb", "det", "noun", "det", "noun", "verb", "conj", "adv", "det", "noun", "adv", "conj", "det", "adj", "pron" ], "roles": [ "subj", "pred", "obj", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "" ] }, { "id": "g91", "level": "long", "source": "reader.sample", "text": "Eventually I discovered that a word learned in the middle of a sentence stays with you longer than a word learned from a list.", "pos": [ "adv", "pron", "verb", "conj", "det", "noun", "verb", "prep", "det", "noun", "prep", "det", "noun", "verb", "prep", "pron", "adv", "conj", "det", "noun", "verb", "prep", "det", "noun" ], "roles": [ "", "subj", "pred", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "" ] }, { "id": "g92", "level": "long", "source": "reader.sample", "text": "A definition you have to look up three times is not yet yours; a word you have met in three different stories is beginning to be.", "pos": [ "det", "noun", "pron", "verb", "part", "verb", "adv", "num", "noun", "verb", "adv", "adv", "pron", "det", "noun", "pron", "aux", "verb", "prep", "num", "adj", "noun", "aux", "verb", "part", "verb" ], "roles": [ "subj", "subj", "", "", "", "", "", "", "", "pred", "", "", "comp", "subj", "subj", "", "", "", "", "", "", "", "aux", "pred", "", "" ] }, { "id": "g93", "level": "simple", "source": "reader.sample", "text": "Put the coat on the back of the chair, pick a paragraph, and begin.", "pos": [ "verb", "det", "noun", "prep", "det", "noun", "prep", "det", "noun", "verb", "det", "noun", "conj", "verb" ], "roles": [ "pred", "obj", "obj", "", "", "", "", "", "", "pred", "obj", "obj", "", "pred" ] }, { "id": "g94", "level": "long", "source": "reader.sample", "text": "Coats go on the backs of chairs, bags are placed carefully on the floor, and the only sounds are the turning of pages, an occasional cough, and the soft scratch of a pencil.", "pos": [ "noun", "verb", "prep", "det", "noun", "prep", "noun", "noun", "aux", "verb", "adv", "prep", "det", "noun", "conj", "det", "adv", "noun", "verb", "det", "noun", "prep", "noun", "det", "adj", "noun", "conj", "det", "adj", "noun", "prep", "det", "noun" ], "roles": [ "subj", "pred", "", "", "", "", "", "subj", "aux", "pred", "", "", "", "", "", "subj", "subj", "subj", "pred", "comp", "comp", "comp", "comp", "", "", "", "", "", "", "", "", "", "" ] } ]
