{ "v": 1, "note": "人工标注金标语料：pos=按语境词性；roles=主干成分（subj/pred/obj/comp/aux），其余留空。由 parser-engine 手工标注。", "sentences": [ { "id": "g01", "text": "The students read books every day.", "pos": [ "det", "noun", "verb", "noun", "det", "noun" ], "level": "simple", "roles": [ "subj", "subj", "pred", "obj", "", "" ] }, { "id": "g02", "text": "She teaches history at a local school.", "pos": [ "pron", "verb", "noun", "prep", "det", "adj", "noun" ], "level": "simple", "roles": [ "subj", "pred", "obj", "", "", "", "" ] }, { "id": "g03", "text": "My brother bought a new bicycle yesterday.", "pos": [ "det", "noun", "verb", "det", "adj", "noun", "adv" ], "level": "simple", "roles": [ "subj", "subj", "pred", "obj", "obj", "obj", "" ] }, { "id": "g04", "text": "The company hired three engineers last month.", "pos": [ "det", "noun", "verb", "num", "noun", "adj", "noun" ], "level": "simple", "roles": [ "subj", "subj", "pred", "obj", "obj", "", "" ] }, { "id": "g05", "text": "They discussed the problem for two hours.", "pos": [ "pron", "verb", "det", "noun", "prep", "num", "noun" ], "level": "simple", "roles": [ "subj", "pred", "obj", "obj", "", "", "" ] }, { "id": "g06", "text": "He answered the question quickly.", "pos": [ "pron", "verb", "det", "noun", "adv" ], "level": "simple", "roles": [ "subj", "pred", "obj", "obj", "" ] }, { "id": "g07", "text": "The teacher explained the rule clearly.", "pos": [ "det", "noun", "verb", "det", "noun", "adv" ], "level": "simple", "roles": [ "subj", "subj", "pred", "obj", "obj", "" ] }, { "id": "g08", "text": "We visited the museum on Sunday.", "pos": [ "pron", "verb", "det", "noun", "prep", "propn" ], "level": "simple", "roles": [ "subj", "pred", "obj", "obj", "", "" ] }, { "id": "g09", "text": "The weather is cold today.", "pos": [ "det", "noun", "verb", "adj", "adv" ], "level": "simple", "roles": [ "subj", "subj", "pred", "comp", "" ] }, { "id": "g10", "text": "She became a doctor five years ago.", "pos": [ "pron", "verb", "det", "noun", "num", "nou